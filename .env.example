# Local development only. Copy to .env, then generate a unique SESSION_SECRET.
APP_ENV=development
DATABASE_URL=sqlite:///./gef-local.sqlite3
SESSION_SECRET=
APP_ORIGIN=http://localhost:8000
SESSION_DAYS=7

# HTTPS tiles. Respect provider attribution, terms, traffic limits and token restrictions.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors
TILE_FALLBACK_URL=
TILE_FALLBACK_ATTRIBUTION=

# Optional Nominatim-compatible reverse geocoder. Blank => coordinates stay visible.
GEOCODING_URL=
GEOCODING_MIN_INTERVAL=1
PROVIDER_USER_AGENT=GEF_system/1.0

# OSRM-compatible driving API base; configure an actual HTTPS provider/self-hosted engine.
# Development-only public demo option: https://router.project-osrm.org (no SLA; see README).
ROUTING_URL=
ROUTING_MIN_INTERVAL=1
ROUTING_API_KEY=
PRESSURE_FRESH_HOURS=6

# Optional OpenAI-compatible chat-completions provider. No key => database answers.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Optional verified Telegram launch metadata; ordinary password login works without a bot.
TELEGRAM_BOT_TOKEN=
SUPPORT_CHAT_URL=https://t.me/WebShadoWin

# Optional one-time CLI provisioning inputs. Never expose these to the browser.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234567u
