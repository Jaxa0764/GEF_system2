# Production environment template. Copy to .env on Railway and fill in the values.
APP_ENV=production
# PostgreSQL connection string, e.g.:
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname
DATABASE_URL=
# 32‑character random secret. Generate with `python -c "import secrets,sys;print(secrets.token_urlsafe(48))"`
SESSION_SECRET=
# The public URL where the app is reachable (must be HTTPS in production).
APP_ORIGIN=https://<your‑railway‑subdomain>.up.railway.app
SESSION_DAYS=7

# Tile server for map display.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors
TILE_FALLBACK_URL=
TILE_FALLBACK_ATTRIBUTION=

# Optional reverse geocoder.
GEOCODING_URL=
GEOCODING_MIN_INTERVAL=1
PROVIDER_USER_AGENT=GEF_system/1.0

# Routing provider (OSRM, GraphHopper, etc.).
ROUTING_URL=
ROUTING_MIN_INTERVAL=1
ROUTING_API_KEY=
PRESSURE_FRESH_HOURS=6

# OpenAI-compatible chat model (optional).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Telegram bot (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=
SUPPORT_CHAT_URL=https://t.me/WebShadoWin

# Admin credentials for first admin creation (optional, set via Railway env vars).
ADMIN_USERNAME=
ADMIN_PASSWORD=
